{
    "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
    "appId": "com.flowstate.app",
    "productName": "FlowState",
    "directories": {
        "output": "out"
    },
    "files": [
        "dist/**/*",
        "main/**/*",
        "package.json"
    ],
    "win": {
        "target": "nsis",
        "icon": "public/assets/icons/icon.png"
    },
    "mac": {
        "target": "dmg",
        "icon": "public/assets/icons/icon.png"
    },
    "linux": {
        "target": "AppImage",
        "icon": "public/assets/icons/icon.png"
    }
}