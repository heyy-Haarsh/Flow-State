{
    "name": "flowstate",
    "version": "1.0.0",
    "description": "AI-Powered Smart Task & Energy Manager",
    "main": "main/main.js",
    "scripts": {
        "dev": "vite",
        "dev:electron": "electron .",
        "rebuild": "npx electron-rebuild -f -w better-sqlite3",
